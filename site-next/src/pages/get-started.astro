---
import Page from "../layouts/Page.astro";
import CodeBlock from "../components/content/CodeBlock.astro";
import type { Lang } from "../lib/highlight";
import CodeTabs from "../components/content/CodeTabs.astro";
import { tlsExamples } from "../data/tls-examples";
import SideNav from "../components/content/SideNav.astro";
import Tabs from "../components/content/Tabs.astro";
import PageIntro from "../components/PageIntro.astro";
import { site, clients } from "../config/site";
import { serverVersion } from "../data/bench";

const v = serverVersion;

const install: Record<string, { code: string; lang: Lang; title?: string; registryUrl: string }> = {
  rust: { code: "cargo add ruvio-client", lang: "shell", registryUrl: "https://crates.io/crates/ruvio-client" },
  csharp: { code: "dotnet add package Ruvio.Client", lang: "shell", registryUrl: "https://www.nuget.org/packages/Ruvio.Client" },
  go: { code: "go get github.com/salihcantekin/ruvio/clients/go", lang: "shell", registryUrl: "https://pkg.go.dev/github.com/salihcantekin/ruvio/clients/go" },
  java: {
    code: `implementation("io.github.salihcantekin:ruvio-client:0.1.0")`,
    lang: "kotlin",
    title: "build.gradle.kts",
    registryUrl: "https://central.sonatype.com/artifact/io.github.salihcantekin/ruvio-client",
  },
  python: { code: "pip install ruvio-client", lang: "shell", registryUrl: "https://pypi.org/project/ruvio-client/" },
  node: { code: "npm install ruvio-client", lang: "shell", registryUrl: "https://www.npmjs.com/package/ruvio-client" },
};

const nav = [
  { id: "run", label: "Run the server" },
  { id: "connect", label: "Connect with redis-cli" },
  { id: "durability", label: "Choose durability" },
  { id: "clients", label: "Add a client" },
  { id: "tls", label: "Encrypt with TLS" },
  { id: "ui", label: "Operator UI" },
  { id: "next", label: "Next steps" },
];

const profiles = [
  { name: "memory", loses: "The whole dataset. This is the default. No WAL." },
  { name: "snapshot", loses: "Writes since the last completed checkpoint." },
  { name: "everysec", loses: "About one sync interval. The client is acknowledged after the append, and the file is synced on <code>sync_interval_ms</code> (default 1000)." },
  { name: "always", loses: "The record is synced before it is applied and before the reply." },
];

const next = [
  { title: "Configuration", text: "Every setting with its TOML field, environment variable and flag.", href: "/docs/configuration/" },
  { title: "Commands", text: "The command reference, including the coordination commands.", href: "/docs/commands/" },
  { title: "Use cases", text: "Rate limits, locks, idempotency, cache fills and delayed jobs.", href: "/use-cases/" },
  { title: "Clients", text: "Guides for the Rust, C#, Go, Java, Python and Node.js clients.", href: "/docs/clients/" },
  { title: "Connection model", text: "Who chooses servers, shards and logical databases: the server, the client or the app.", href: "/docs/connection-model/" },
  { title: "Recovery", text: "What happens on restart, and how to back up and restore.", href: "/docs/recovery/" },
];
---

<Page title="Get started" description="Run Ruvio with Docker or a prebuilt binary, connect with redis-cli, choose a durability profile and add a client.">
  <PageIntro title="Get started" kicker="Four steps">
    Run the server, connect with <code>redis-cli</code>, then add a client. A default process listens on{" "}
    <code>127.0.0.1:6379</code>, and <code>PING</code> answers <code>PONG</code>.
    <a slot="after" class="wizard-card" href="/get-started/wizard/">
      <span class="wizard-tag">Setup wizard</span>
      <span class="wizard-body">
        <b>Answer a few questions, copy one file.</b>
        One server, replicas, automatic failover or a cluster: the wizard writes the Docker Compose file or the Bash or
        PowerShell script, with passwords and the commands that check it.
      </span>
      <span class="btn wizard-btn">Open the wizard</span>
    </a>
  </PageIntro>

  <div class="reading">
   <div class="wrap">
    <SideNav items={nav} label="Steps">
      <section class="step panel prose" id="run" aria-labelledby="run-h">
        <h2 id="run-h"><span class="step-no" aria-hidden="true">1</span>Run the server</h2>
        <Tabs id="run-tabs" label="How to run Ruvio" labels={["Docker", "Prebuilt binary", "From source"]}>
          <div>
            <p>
              Docker Hub has one Linux image. <code>linux</code> and <code>latest</code> are the same image, as is each
              version tag, built for linux/amd64 and linux/arm64 (Apple Silicon and other arm64 hosts run it natively).
            </p>
            <CodeBlock lang="shell" code={`docker run --rm -p 6379:6379 \\
  -e RUVIO_REQUIREPASS=change-me \\
  -v ruvio-data:/data \\
  salihcantekin/ruvio:linux`} />
            <p>
              The container sets <code>RUVIO_PROTECTED_MODE=false</code> because a published port is not loopback inside
              the namespace, so put a password on any bind that is not loopback. The image default durability is{" "}
              <code>memory</code>; a persistent deploy sets <code>RUVIO_DURABILITY</code> and keeps the volume.
              The process runs as UID 10001.
            </p>
            <details class="expand">
              <summary>Two shards in one container</summary>
              <p>
                Two shards publish consecutive ports. Advertise the host clients can reach; without that,{" "}
                <code>CLUSTER SLOTS</code> hands out <code>127.0.0.1</code> and a remote app cannot follow <code>MOVED</code>.
              </p>
              <CodeBlock lang="shell" code={`docker run --rm -p 6379-6380:6379-6380 \\
  -e RUVIO_SHARDS=2 \\
  -e RUVIO_ADDR=0.0.0.0:6379 \\
  -e RUVIO_ADVERTISE_HOST=YOUR_SERVER_IP \\
  -e RUVIO_PROTECTED_MODE=false \\
  -v ruvio-data:/data \\
  salihcantekin/ruvio:linux`} />
              <p>First-party clients take only <code>YOUR_SERVER_IP:6379</code>. They read the slot map and open 6380 themselves.</p>
            </details>
          </div>
          <div>
            <p>
              <a href={site.releases}>GitHub Releases</a> has prebuilt binaries for Linux x64 and arm64, macOS arm64 and
              Windows x64. Each archive holds <code>ruvio</code> (the server), <code>ruvio-ctl</code> (backup, restore and
              checks), <code>ruvio.example.toml</code>, the README and the license; <code>SHA256SUMS</code> lists the checksums.
            </p>
            <CodeBlock lang="shell" code={`# Linux x64; swap the platform for linux-arm64 or macos-arm64
v=${v}
curl -LO https://github.com/salihcantekin/ruvio/releases/download/ruvio-$v/ruvio-$v-linux-x64.tar.gz
tar xzf ruvio-$v-linux-x64.tar.gz
cd ruvio-$v-linux-x64
./ruvio --requirepass change-me --data-dir ./data`} />
            <p>
              On Windows, unzip <code>ruvio-&lt;version&gt;-windows-x64.zip</code> and run <code>ruvio.exe</code>. On macOS,
              a binary downloaded by a browser is quarantined; <code>xattr -d com.apple.quarantine ruvio ruvio-ctl</code>{" "}
              clears it (downloads with <code>curl</code> are not quarantined). <code>ruvio --help</code> lists every flag.
            </p>
          </div>
          <div>
            <p>From a checkout of the repository, with the Rust toolchain installed:</p>
            <CodeBlock lang="shell" code={`cargo run --release --bin ruvio`} />
            <p>
              The server is installed from the Docker image, a release binary, or built from a checkout; it is not
              published as a crate.
            </p>
          </div>
        </Tabs>
      </section>

      <section class="step panel prose" id="connect" aria-labelledby="connect-h">
        <h2 id="connect-h"><span class="step-no" aria-hidden="true">2</span>Connect with redis-cli</h2>
        <p>Ruvio speaks RESP2, so <code>redis-cli</code> and existing RESP clients connect as they would to Redis.</p>
        <CodeBlock lang="shell" code={`redis-cli -h 127.0.0.1 -p 6379 -a change-me PING
# PONG`} />
        <p>
          Settings merge in this order: built-in defaults, <code>ruvio.toml</code> (or <code>--config</code> /{" "}
          <code>RUVIO_CONFIG</code>), <code>RUVIO_*</code> environment variables, then command-line flags. The file is
          read once, at process start, and unknown TOML fields are rejected. Memory limits, slowlog, connection limits,
          script limits and the password also change while the server runs with <code>CONFIG SET</code>, and
          <code>CONFIG REWRITE</code> writes them back to the file; see <a href="/docs/configuration/#changing-settings-at-runtime">Changing settings at runtime</a>.
        </p>
      </section>

      <section class="step panel prose" id="durability" aria-labelledby="durability-h">
        <h2 id="durability-h"><span class="step-no" aria-hidden="true">3</span>Choose a durability profile</h2>
        <p>
          You choose how much a crash can lose, at startup. A write is checked, appended, then applied. If the log
          cannot take the record, the key stays as it was and later writes return <code>MISCONF</code>.
        </p>
        <div class="table-wrap">
          <table>
            <thead><tr><th scope="col">Profile</th><th scope="col">What a crash can lose</th></tr></thead>
            <tbody>
              {profiles.map((p) => (
                <tr><td><code>{p.name}</code></td><td set:html={p.loses} /></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p>
          Set it with <code>--durability</code>, <code>RUVIO_DURABILITY</code> or <code>persistence.profile</code> in{" "}
          <code>ruvio.toml</code>. Shard count, bind address and durability cannot change under a live process.
        </p>
        <CodeBlock lang="shell" code={`docker run --rm -p 6379:6379 \\
  -e RUVIO_REQUIREPASS=change-me \\
  -e RUVIO_DURABILITY=everysec \\
  -v ruvio-data:/data \\
  salihcantekin/ruvio:linux`} />
      </section>

      <section class="step panel prose" id="clients" aria-labelledby="clients-h">
        <h2 id="clients-h"><span class="step-no" aria-hidden="true">4</span>Add a client</h2>
        <p>
          First-party clients speak RESP2, do not send <code>CLIENT SETINFO</code>, and learn <code>CLUSTER SLOTS</code>{" "}
          from one seed address. The Go module is released by git tag and served by the Go module proxy; the others are
          published to their registries.
        </p>
        <p>
          Against a sharded server each client sends a command straight to the shard that owns its key. A pipeline
          whose keys land on several shards is written to every shard before any reply is read, so it still costs one
          round trip. The rules and
          the measured cost per client are in <a href="/docs/client-behavior/#routing-cost">Client behavior</a>; the
          C# client also has an opt-in reader thread per socket (<code>DedicatedReaderThread</code>) for the lowest CPU
          per round trip. A read policy (<code>prefer-replica</code> or <code>replica</code>) sends read-only commands
          to the replicas the server lists; see <a href="/docs/client-behavior/#reads-from-replicas">Reads from replicas</a>.
        </p>
        <ul class="client-list">
          {clients.map((c) => {
            const i = install[c.slug];
            return (
              <li class="client">
                <div class="client-head">
                  <h3>{c.language}</h3>
                  <a class="registry" href={i.registryUrl}>{c.registry}</a>
                </div>
                <CodeBlock code={i.code} lang={i.lang} title={i.title} />
                <a class="guide" href={`/docs/clients/${c.slug}/`}>{c.language} guide</a>
              </li>
            );
          })}
        </ul>
        <p>
          For ASP.NET Core, <code>Ruvio.Client.AspNetCore</code> registers the connection with dependency injection:{" "}
          <code>dotnet add package Ruvio.Client.AspNetCore</code>.
        </p>
      </section>

      <section class="step panel prose" id="tls" aria-labelledby="tls-h">
        <h2 id="tls-h">Encrypt with TLS</h2>
        <p>
          TLS is off by default. Give the server a certificate and key and its client port speaks TLS only; every
          first-party client can then connect with it, checking the certificate chain and the host name.
        </p>
        <CodeBlock lang="shell" code={`ruvio --tls-cert server.pem --tls-key server-key.pem
# or RUVIO_TLS_CERT / RUVIO_TLS_KEY, or security.tls_cert / security.tls_key in ruvio.toml
# add tls_client_ca and tls_client_auth to demand client certificates (mutual TLS)`} />
        <CodeTabs id="tls-clients" label="Connect with TLS" tabs={clients.map((k) => ({ key: k.slug, label: k.language, lang: k.lang, code: tlsExamples[k.slug] }))} />
        <p>
          Every client also takes a client certificate for mutual TLS and a server name for connecting by IP address.
          Skipping verification is a separate, clearly named option for throwaway tests only. The settings are in{" "}
          <a href="/docs/configuration/">Configuration</a>, and each client guide has a TLS section:{" "}
          <a href="/docs/clients/">Clients</a>. The operator UI connects to a TLS server with{" "}
          <code>RUVIO_UI_TLS</code>; see <a href="/docs/ui-connections/">UI connections</a>.
        </p>
      </section>

      <section class="step panel prose" id="ui" aria-labelledby="ui-h">
        <h2 id="ui-h">Operator UI</h2>
        <p>
          A browser view of a running server or cluster: a dashboard of time charts you choose, a read-only cluster view (groups, shards,
          slots, replicas and, with <code>RUVIO_UI_COORDINATORS</code>, the coordinators), data, command forms, a
          command console, Pub/Sub and ACL users. The container serves the
          browser and connects to the Ruvio server named by <code>RUVIO_UI_TARGET_HOST</code> and{" "}
          <code>RUVIO_UI_TARGET_PORT</code>. Sign-in is the server ACL user.
        </p>
        <CodeBlock lang="shell" code={`docker pull salihcantekin/ruvio-ui:linux
docker run --rm -p 8080:8080 \\
  -e RUVIO_UI_TARGET_HOST=127.0.0.1 \\
  -e RUVIO_UI_TARGET_PORT=6379 \\
  salihcantekin/ruvio-ui:linux`} />
        <p>Then open <code>http://127.0.0.1:8080</code>. Port 8080 is only the UI.</p>
        <figure class="shot">
          <img src="/images/ui-overview.png" alt="Operator UI overview: groups, slot map, keys, memory and shard health of a two-group cluster" width="1440" height="1100" loading="lazy" />
        </figure>
        <h3 id="ui-dashboard">Dashboard and cluster view</h3>
        <p>
          The Dashboard, below Console in the menu, draws time charts of the <code>INFO</code> fields: commands per
          second, network bytes, memory and its breakdown, keys, WAL records, replication lag and more. You pick the
          charts, a 5, 15 or 30 minute window, and whether lines are added up or drawn per node. The charts come from
          the same single <code>INFO</code> per node that each refresh already reads, so they add no load on the server.
          The Cluster screen shows each group with its shards, slot ranges, primaries and replicas, and, with
          coordinators configured, the leader, each group's agreed primary and the failovers seen while it is open.
        </p>
        <div class="shots">
          <figure class="shot"><img src="/images/ui-dashboard.png" alt="Dashboard with time charts of commands per second, network bytes and memory" width="1440" height="1100" loading="lazy" /></figure>
          <figure class="shot"><img src="/images/ui-cluster.png" alt="Cluster screen with two groups, their replicas and three coordinators" width="1440" height="1100" loading="lazy" /></figure>
        </div>
        <h3 id="ui-console">Console</h3>
        <p>
          The Console tab, at the bottom of the menu, runs server commands from the browser. It opens only when you
          press <strong>Connect console</strong>, and commands run with the permissions of the user you signed in as.
          Replies are formatted: JSON is pretty-printed, multi-line text such as <code>INFO</code> shows as plain
          lines, and large results are cut on screen with <strong>Show more</strong>, <strong>Copy all</strong> and{" "}
          <strong>Download</strong> for the full text. Errors keep the server's message and add a short hint, and
          destructive commands such as <code>FLUSHALL</code> ask before they run. Subscriptions and blocking commands
          are refused; Pub/Sub has its own screen.
        </p>
        <div class="shots">
          <figure class="shot"><img src="/images/ui-console.png" alt="Console running commands and showing a formatted JSON reply" width="1440" height="1100" loading="lazy" /></figure>
          <figure class="shot"><img src="/images/ui-data.png" alt="Data screen showing a JSON document as a tree" width="1440" height="1100" loading="lazy" /></figure>
        </div>
        <h3 id="ui-docker">UI in Docker, Ruvio on the same machine</h3>
        <p>
          Inside the container, <code>localhost</code> is the container itself. Give the UI the name of the machine that
          runs Docker, <code>host.docker.internal</code>, and start the Ruvio binary on an address the container can
          reach, with a password:
        </p>
        <CodeBlock lang="shell" code={`ruvio --address 0.0.0.0:6379 --requirepass change-me

docker run --rm -p 8080:8080 \\
  -e RUVIO_UI_TARGET_HOST=host.docker.internal \\
  -e RUVIO_UI_TARGET_PORT=6379 \\
  -e RUVIO_UI_TARGET_PASSWORD=change-me \\
  salihcantekin/ruvio-ui:linux`} />
        <p>
          With more than one shard, sign in to any one shard port; the UI finds the others from the server and needs every
          shard port reachable. Set <code>RUVIO_ADVERTISE_HOST</code> on the server to a name the UI can reach. The
          Windows firewall rule, Linux notes and a list of connection errors are in{" "}
          <a href="/docs/ui-connections/">Connecting the Operator UI</a>; the same file ships in every server download.
        </p>
      </section>

      <section class="step panel prose" id="next" aria-labelledby="next-h">
        <h2 id="next-h">Next steps</h2>
        <div class="grid grid-2 next-grid">
          {next.map((n) => (
            <a class="card" href={n.href}>
              <h3>{n.title}</h3>
              <p>{n.text}</p>
              <span class="more">Read</span>
            </a>
          ))}
        </div>
      </section>
    </SideNav>
   </div>
  </div>
</Page>

<style>
  .wizard-card {
    display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 18px; align-items: center;
    margin-top: 26px; max-width: 980px; padding: 18px 22px; text-decoration: none; color: var(--ink-body);
    border: 1px solid color-mix(in srgb, var(--accent) 55%, var(--paper-line)); border-radius: var(--radius);
    background: color-mix(in srgb, var(--accent) 10%, var(--paper)); transition: border-color 0.15s, background 0.15s;
  }
  .wizard-card:hover { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 15%, var(--paper)); }
  .wizard-card:focus-visible { outline: 2px solid var(--c2); outline-offset: 3px; }
  .wizard-tag {
    font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--c1);
    border: 1px solid color-mix(in srgb, var(--c1) 45%, transparent); border-radius: 4px; padding: 4px 8px; white-space: nowrap;
  }
  .wizard-body { font-size: 16px; line-height: 1.5; }
  .wizard-body b { display: block; font-size: 18px; color: var(--ink); margin-bottom: 2px; }
  .wizard-btn { white-space: nowrap; }
  @media (max-width: 760px) {
    .wizard-card { grid-template-columns: minmax(0, 1fr); gap: 12px; }
    .wizard-tag { justify-self: start; }
    .wizard-btn { justify-self: start; }
  }
  .step { scroll-margin-top: 88px; display: grid; gap: 16px; }
  .step + .step { margin-top: 20px; }
  .shot { margin: 0; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--code-bg); }
  .shot img { display: block; width: 100%; height: auto; }
  .shots { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  @media (max-width: 760px) { .shots { grid-template-columns: 1fr; } }
  .step > * + * { margin-top: 0; }
  .step h2 { display: flex; align-items: center; gap: 14px; margin: 0 0 4px; font-size: 24px; line-height: 1.25; color: var(--ink); }
  .step-no {
    display: inline-grid; place-items: center; width: 30px; height: 30px; flex: none;
    font-family: var(--f-mono); font-size: 14px; font-weight: 500; color: var(--c1);
    border: 1px solid color-mix(in srgb, var(--c1) 45%, var(--paper-line)); border-radius: 4px;
  }
  .table-wrap { border-color: var(--paper-line); }
  .table-wrap td:first-child { white-space: nowrap; }
  .table-wrap td { color: var(--ink-body); }

  .expand { border: 1px solid var(--paper-line); border-radius: var(--radius-s); background: var(--surface); }
  .expand summary { cursor: pointer; padding: 12px 16px; font-weight: 600; font-size: 16px; color: var(--ink); }
  .expand[open] { display: grid; gap: 14px; padding-bottom: 16px; }
  .expand[open] > :not(summary) { margin-inline: 16px; }
  .expand[open] summary { border-bottom: 1px solid var(--line); }

  .client-list { list-style: none; margin: 4px 0; padding: 0; display: grid; gap: 14px; container-type: inline-size; }
  .client { display: grid; gap: 12px; align-content: start; padding: 18px; border: 1px solid var(--paper-line); border-radius: var(--radius); background: var(--surface); min-width: 0; }
  .client-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .client h3 { margin: 0; font-size: 18px; color: var(--ink); }
  .client .registry { font-size: 14px; color: var(--mute); text-decoration: none; }
  .client .guide { font-size: 15px; font-weight: 600; text-decoration: none; }
  .client .guide::after { content: " →"; color: var(--mute); }
  .client :global(pre) { font-size: 14px; padding: 12px 14px 14px; }
  @supports (container-type: inline-size) {
    .step { container-type: inline-size; }
  }
  @container (min-width: 640px) { .client-list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  .next-grid { gap: 16px; }
  .next-grid .card { padding: 20px 22px; background: var(--surface); border-color: var(--paper-line); }
  .next-grid .card h3 { font-size: 18px; color: var(--ink); }
  @media (max-width: 900px) {
    .step { scroll-margin-top: 124px; }
    .step h2 { font-size: 21px; }
  }
</style>
