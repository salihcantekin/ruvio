---
// The one code box of the marketing pages: highlighted at build time (src/lib/highlight.ts), with
// the language in its frame, an optional file or tool name next to it, and a copy button.
import { highlight, languages, type Lang } from "../../lib/highlight";

interface Props { code: string; lang: Lang; title?: string; copy?: boolean }
const { code, lang, title, copy = true } = Astro.props;

const html = await highlight(code, lang);
---

<figure class="term code-block" data-lang={lang}>
  <figcaption class="term-bar">
    <span class="label"><b>{languages[lang]}</b>{title && <span>{title}</span>}</span>
    {copy && <button type="button" class="copy" data-copy hidden>Copy</button>}
  </figcaption>
  <pre tabindex="0"><code set:html={html} /></pre>
</figure>

<style>
  .code-block { margin: 0; }
  .code-block .term-bar { align-items: center; min-height: 40px; padding-block: 6px; }
  .label { display: flex; gap: 8px; align-items: baseline; min-width: 0; }
  .label b { font-weight: 500; color: var(--code-ink); }
  .label span::before { content: "·"; margin-right: 8px; color: var(--code-dim); }
  .code-block pre { font-size: 14.5px; line-height: 1.7; }
  .code-block pre:focus-visible { outline: 2px solid var(--c2); outline-offset: -2px; }
  @media (max-width: 600px) {
    .code-block pre { font-size: 13.5px; padding: 14px 16px 16px; }
  }
  .copy {
    font: inherit; font-size: 13px; color: var(--code-dim); background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 4px; padding: 3px 9px; cursor: pointer;
  }
  .copy:hover { color: var(--code-ink); border-color: rgba(255, 255, 255, 0.22); }
</style>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>(".code-block [data-copy]")) {
    if (!navigator.clipboard) continue;
    btn.hidden = false;
    btn.addEventListener("click", async () => {
      const code = btn.closest(".code-block")?.querySelector("code")?.textContent ?? "";
      try {
        await navigator.clipboard.writeText(code);
        btn.textContent = "Copied";
      } catch {
        btn.textContent = "Copy failed";
      }
      setTimeout(() => (btn.textContent = "Copy"), 1600);
    });
  }
</script>
