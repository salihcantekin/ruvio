---
import "../../styles/animations.css";
---

<figure class="an-wrap">
  <svg class="an fo" viewBox="0 0 640 340" role="img" aria-label="A primary node drops off the network, the replicas vote, one becomes primary and the client keeps writing"><rect class="nd " x="20" y="134" width="110" height="70" rx="12"/><image href="/images/ruvio-mark-128.png" x="30" y="143" width="22" height="22"/><text class="b" x="86.0" y="159" text-anchor="middle">Client</text><text class="sm m" x="75" y="182" text-anchor="middle">SET / GET</text><path class="ln" d="M130 169 L300 80"/><path class="ln" d="M130 169 L300 210"/><path class="ln" d="M450 80 L500 140"/><path class="ln" d="M450 210 L500 150"/><path class="ln" d="M375 120 L375 170" stroke-dasharray="4 4"/><rect class="nd " x="300" y="40" width="150" height="80" rx="12"/><image href="/images/ruvio-mark-128.png" x="310" y="49" width="22" height="22"/><text class="b" x="386.0" y="65" text-anchor="middle">Node A</text><circle class="led" cx="436" cy="56" r="4" fill="var(--ok)"/><rect class="nd " x="300" y="170" width="150" height="80" rx="12"/><image href="/images/ruvio-mark-128.png" x="310" y="179" width="22" height="22"/><text class="b" x="386.0" y="195" text-anchor="middle">Node B</text><circle class="led" cx="436" cy="186" r="4" fill="var(--ok)"/><rect class="nd " x="500" y="105" width="120" height="80" rx="12"/><image href="/images/ruvio-mark-128.png" x="510" y="114" width="22" height="22"/><text class="b" x="571.0" y="130" text-anchor="middle">Node C</text><circle class="led" cx="606" cy="121" r="4" fill="var(--ok)"/><g class="fo-w0"><rect class="pillf" x="320" y="84" width="110" height="24" rx="12"/><text class="pt" x="375.0" y="100" text-anchor="middle">PRIMARY</text></g><g class="fo-w1"><rect class="pillf" x="320" y="84" width="110" height="24" rx="12" style="fill:var(--bad)"/><text class="pt" x="375.0" y="100" text-anchor="middle">OFFLINE</text><path d="M296 36 L454 124 M454 36 L296 124" stroke="var(--bad)" stroke-width="3" opacity=".5"/></g><g class="fo-w2"><rect class="pill" x="320" y="214" width="110" height="24" rx="12"/><text class="sm m" x="375.0" y="230" text-anchor="middle">REPLICA</text></g><g class="fo-w3"><rect class="pillf" x="320" y="214" width="110" height="24" rx="12"/><text class="pt" x="375.0" y="230" text-anchor="middle">PRIMARY</text></g><rect class="pill" x="510" y="150" width="100" height="24" rx="12"/><text class="sm m" x="560.0" y="166" text-anchor="middle">REPLICA</text><g class="fo-w4"><circle class="ring" cx="375" cy="210" r="26"/><circle class="ring" cx="560" cy="145" r="26" style="animation-delay:.6s"/></g><g class="fo-w0"><circle class="pk" cx="130" cy="169" r="5" fill="var(--c1)" style="--dx:170px;--dy:-89px;animation-delay:0s;"/><circle class="pk" cx="450" cy="80" r="4" fill="var(--c2)" style="--dx:50px;--dy:60px;animation-delay:0.7s;"/><circle class="pk" cx="450" cy="80" r="4" fill="var(--c2)" style="--dx:50px;--dy:60px;animation-delay:0.7s;"/></g><g class="fo-w6"><circle class="pk" cx="130" cy="169" r="5" fill="var(--c1)" style="--dx:170px;--dy:41px;animation-delay:0s;"/><circle class="pk" cx="450" cy="210" r="4" fill="var(--c2)" style="--dx:50px;--dy:-60px;animation-delay:0.7s;"/></g><g class="fo-w5"><text x="215" y="108" text-anchor="middle" class="sm" style="fill:var(--bad)">✕ unreachable</text></g><rect class="cap" x="16" y="282" width="608" height="38" rx="10"/><g class="fo-w7"><text x="320.0" y="306" text-anchor="middle">Normal: A takes writes, B and C stay in sync.</text></g><g class="fo-w8"><text x="320.0" y="306" text-anchor="middle" style="fill:var(--bad)">A drops off the network. B and C vote by majority…</text></g><g class="fo-w9"><text x="320.0" y="306" text-anchor="middle">B becomes primary. The client follows it automatically.</text></g><g class="fo-w10 an-fin"><text x="320.0" y="306" text-anchor="middle" style="fill:var(--ok)">Writes continue where they left off.</text></g></svg>
  <figcaption><b>A node drops off, Ruvio keeps serving</b>The coordinator promotes a replica by majority vote; clients follow the new primary on their own.</figcaption>
</figure>
