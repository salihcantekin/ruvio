import "../../styles/animations.css";
---

<figure class="an-wrap">
  <svg class="an sl" viewBox="0 0 480 290" role="img" aria-label="Hash slots move from node A to node B while traffic continues"><rect class="nd " x="24" y="24" width="150" height="80" rx="12"/><image href="/images/ruvio-mark-128.png" x="34" y="33" width="22" height="22"/><text class="b" x="110.0" y="49" text-anchor="middle">Node A</text><circle class="led" cx="160" cy="40" r="4" fill="var(--ok)"/><rect class="nd " x="306" y="24" width="150" height="80" rx="12"/><image href="/images/ruvio-mark-128.png" x="316" y="33" width="22" height="22"/><text class="b" x="392.0" y="49" text-anchor="middle">Node B</text><circle class="led" cx="442" cy="40" r="4" fill="var(--ok)"/><path class="ln" d="M174 64 L306 64"/><g class="sl-w1"><circle class="pk" cx="174" cy="64" r="4" fill="var(--c1)" style="--dx:132px;--dy:0px;animation-delay:0s;"/><circle class="pk" cx="174" cy="64" r="4" fill="var(--c1)" style="--dx:132px;--dy:0px;animation-delay:0.45s;"/><circle class="pk" cx="174" cy="64" r="4" fill="var(--c1)" style="--dx:132px;--dy:0px;animation-delay:0.9s;"/></g><text class="sm m" x="240" y="52" text-anchor="middle">slots</text><rect x="17.0" y="150" width="26" height="32" rx="4" fill="var(--c1)" opacity=".9"/><rect x="45.0" y="150" width="26" height="32" rx="4" fill="var(--c1)" opacity=".9"/><rect x="73.0" y="150" width="26" height="32" rx="4" fill="var(--c1)" opacity=".9"/><rect x="101.0" y="150" width="26" height="32" rx="4" fill="var(--c1)" opacity=".9"/><rect x="129.0" y="150" width="26" height="32" rx="4" fill="var(--c1)" opacity=".9"/><rect x="157.0" y="150" width="26" height="32" rx="4" fill="var(--c1)" opacity=".9"/><rect x="185.0" y="150" width="26" height="32" rx="4" fill="var(--c1)" opacity=".9"/><rect x="213.0" y="150" width="26" height="32" rx="4" fill="var(--c1)" opacity=".9"/><rect x="241.0" y="150" width="26" height="32" rx="4" fill="var(--c1)" opacity=".9"/><rect x="241.0" y="150" width="26" height="32" rx="4" fill="var(--c2)" style="animation-name:sl-flip;animation-delay:0.0s;opacity:0"/><rect x="269.0" y="150" width="26" height="32" rx="4" fill="var(--c1)" opacity=".9"/><rect x="269.0" y="150" width="26" height="32" rx="4" fill="var(--c2)" style="animation-name:sl-flip;animation-delay:0.35s;opacity:0"/><rect x="297.0" y="150" width="26" height="32" rx="4" fill="var(--c1)" opacity=".9"/><rect x="297.0" y="150" width="26" height="32" rx="4" fill="var(--c2)" style="animation-name:sl-flip;animation-delay:0.7s;opacity:0"/><rect x="325.0" y="150" width="26" height="32" rx="4" fill="var(--c1)" opacity=".9"/><rect x="325.0" y="150" width="26" height="32" rx="4" fill="var(--c2)" style="animation-name:sl-flip;animation-delay:1.0499999999999998s;opacity:0"/><rect x="353.0" y="150" width="26" height="32" rx="4" fill="var(--c1)" opacity=".9"/><rect x="381.0" y="150" width="26" height="32" rx="4" fill="var(--c1)" opacity=".9"/><rect x="409.0" y="150" width="26" height="32" rx="4" fill="var(--c1)" opacity=".9"/><rect x="437.0" y="150" width="26" height="32" rx="4" fill="var(--c1)" opacity=".9"/><text class="sm m" x="17.0" y="204">slot 0</text><text class="sm m" x="463.0" y="204" text-anchor="end">16383</text><g><text class="sm m" x="17.0" y="136"><tspan style="fill:var(--c1)">■</tspan> owned by A  <tspan style="fill:var(--c2)">■</tspan> moved to B</text></g><rect class="cap" x="16" y="228" width="448" height="38" rx="10"/><g class="sl-w0"><text x="240.0" y="252" text-anchor="middle">Rebalance starts. Clients keep reading and writing.</text></g><g class="sl-w1"><text x="240.0" y="252" text-anchor="middle">Moving slots: a key already gone gets ASK → B.</text></g><g class="sl-w2 an-fin"><text x="240.0" y="252" text-anchor="middle" style="fill:var(--ok)">Done: B owns them (MOVED). Clients update their table.</text></g></svg>
