---
import "../../styles/animations.css";
---

<figure class="an-wrap">
  <svg class="an rr" viewBox="0 0 480 300" role="img" aria-label="Writes go to the primary, reads are served by the replicas"><rect class="nd " x="16" y="110" width="100" height="70" rx="12"/><image href="/images/ruvio-mark-128.png" x="26" y="119" width="22" height="22"/><text class="b" x="77.0" y="135" text-anchor="middle">Client</text><rect class="nd " x="200" y="20" width="140" height="64" rx="12"/><image href="/images/ruvio-mark-128.png" x="210" y="29" width="22" height="22"/><text class="b" x="281.0" y="45" text-anchor="middle">Primary</text><rect class="nd " x="200" y="120" width="140" height="64" rx="12"/><image href="/images/ruvio-mark-128.png" x="210" y="129" width="22" height="22"/><text class="b" x="281.0" y="145" text-anchor="middle">Replica 1</text><rect class="nd " x="200" y="220" width="140" height="64" rx="12"/><image href="/images/ruvio-mark-128.png" x="210" y="229" width="22" height="22"/><text class="b" x="281.0" y="245" text-anchor="middle">Replica 2</text><path class="ln" d="M116 145 L200 52"/><path class="ln" d="M116 145 L200 152"/><path class="ln" d="M116 145 L200 252"/><path class="ln" d="M270 84 L270 120"/><path class="ln" d="M270 184 L270 220"/><g class="rr-w0"><circle class="pk" cx="116" cy="145" r="5" fill="var(--c1)" style="--dx:84px;--dy:-93px;animation-delay:0s;animation-duration:1.0s!important;"/><circle class="pk" cx="270" cy="84" r="4" fill="var(--c2)" style="--dx:0px;--dy:36px;animation-delay:0.5s;animation-duration:1.0s!important;"/><circle class="pk" cx="270" cy="184" r="4" fill="var(--c2)" style="--dx:0px;--dy:36px;animation-delay:0.7s;animation-duration:1.0s!important;"/></g><g class="rr-w1"><circle class="pk" cx="116" cy="145" r="5" fill="var(--ok)" style="--dx:84px;--dy:7px;animation-delay:0s;animation-duration:1.0s!important;"/><circle class="pk" cx="116" cy="145" r="5" fill="var(--ok)" style="--dx:84px;--dy:107px;animation-delay:0.5s;animation-duration:1.0s!important;"/></g><rect class="cap" x="360" y="110" width="104" height="90" rx="10"/><g class="rr-w0"><text class="sm" x="412" y="148" text-anchor="middle">writes →</text><text class="sm m" x="412" y="166" text-anchor="middle">primary</text></g><g class="rr-w1 an-fin"><text class="sm" x="412" y="148" text-anchor="middle">reads →</text><text class="sm m" x="412" y="166" text-anchor="middle">replicas</text></g></svg>
  <figcaption><b>Spread reads across replicas</b>Writes go to the primary; replicas stay in sync and serve reads, so read capacity scales out.</figcaption>
</figure>
