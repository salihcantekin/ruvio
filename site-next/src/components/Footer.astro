---
import { footerNav, site } from "../config/site";
import { serverVersion } from "../data/bench";
import Logo from "./Logo.astro";
---

<footer class="site-footer">
  <div class="wrap">
    <div class="cols">
      <div class="about">
        <Logo />
        <p>{site.description}</p>
      </div>
      {footerNav.map((col) => (
        <div>
          <h2>{col.title}</h2>
          <ul>
            {col.items.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
    <div class="legal">
      <span>© {new Date().getFullYear()} Ruvio · v{serverVersion}</span>
      <span>Server AGPL-3.0 · Clients MIT</span>
    </div>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--line); padding-block: 56px 28px; background: var(--bg); }
  .cols { display: grid; grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr)); gap: 32px; }
  .about p { color: var(--mute); font-size: 15.5px; margin: 14px 0 0; max-width: 38ch; }
  h2 { font-size: 14px; font-weight: 600; color: var(--mute); margin: 6px 0 14px; letter-spacing: 0; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 9px; font-size: 15.5px; }
  ul a:hover { color: var(--c2); }
  .legal { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 20px; margin-top: 44px; padding-top: 20px; border-top: 1px solid var(--line); font-size: 14px; color: var(--faint); }
  @media (max-width: 900px) {
    .cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .about { grid-column: 1 / -1; }
  }
</style>
