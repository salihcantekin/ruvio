---
import { mainNav, site } from "../config/site";
import Logo from "./Logo.astro";

const path = Astro.url.pathname;
const isCurrent = (href: string) => href !== "/" && !href.startsWith("/#") && path.startsWith(href);
---

<header class="site-header">
  <div class="wrap bar">
    <Logo />
    <nav class="nav" aria-label="Main">
      {mainNav.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>
      ))}
    </nav>
    <div class="actions">
      <a class="gh" href={site.github} aria-label="Ruvio on GitHub">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        <span>GitHub</span>
      </a>
      <button class="theme" type="button" data-theme-toggle aria-label="Theme: system. Switch to light">
        <svg class="i-light" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="i-dark" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
        <svg class="i-auto" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>
      </button>
      <a class="btn small" href="/get-started/">Get started</a>
      <details class="menu">
        <summary aria-label="Open menu"><span></span><span></span><span></span></summary>
        <nav class="menu-panel" aria-label="Menu">
          {mainNav.map((item) => <a href={item.href}>{item.label}</a>)}
          <a href={site.github}>GitHub</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Cycles system -> light -> dark. Stored under the docs' own key; "" means follow the system.
  const KEY = "starlight-theme";
  const order = ["", "light", "dark"] as const;
  const names = { "": "system", light: "light", dark: "dark" } as const;
  const read = () => {
    try { const v = localStorage.getItem(KEY); return v === "light" || v === "dark" ? v : ""; } catch { return ""; }
  };
  const apply = (mode: (typeof order)[number]) => {
    document.documentElement.dataset.theme = mode || (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
    document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((b) => {
      b.dataset.mode = mode || "auto";
      const next = order[(order.indexOf(mode) + 1) % order.length];
      b.setAttribute("aria-label", `Theme: ${names[mode]}. Switch to ${names[next]}`);
      b.title = `Theme: ${names[mode]}`;
    });
  };
  apply(read());
  document.querySelectorAll("[data-theme-toggle]").forEach((b) =>
    b.addEventListener("click", () => {
      const next = order[(order.indexOf(read()) + 1) % order.length];
      try { localStorage.setItem(KEY, next); } catch {}
      apply(next);
    }),
  );
  matchMedia("(prefers-color-scheme: light)").addEventListener("change", () => read() === "" && apply(""));
</script>

<style>
  .theme { display: grid; place-items: center; width: 36px; height: 36px; padding: 0; border-radius: var(--radius-s); border: 1px solid var(--line); background: transparent; color: var(--mute); cursor: pointer; }
  .theme:hover { color: var(--ink); background: var(--surface-2); }
  .theme svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; display: none; }
  .theme[data-mode="light"] .i-light, .theme[data-mode="dark"] .i-dark, .theme:not([data-mode="light"]):not([data-mode="dark"]) .i-auto { display: block; }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 84%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; gap: 28px; height: 64px; }
  .nav { display: flex; gap: 4px; margin-right: auto; font-size: 16px; }
  .nav a { position: relative; padding: 8px 12px; border-radius: var(--radius-s); color: var(--mute); font-weight: 500; transition: background-color .15s ease, color .15s ease; }
  .nav a:hover { color: var(--ink); background: color-mix(in srgb, var(--ink) 7%, transparent); }
  .nav a[aria-current="page"] { color: var(--ink); font-weight: 600; background: color-mix(in srgb, var(--accent) 12%, transparent); }
  .nav a[aria-current="page"]::after { content: ""; position: absolute; left: 12px; right: 12px; bottom: -13px; height: 2px; border-radius: 2px; background: var(--accent); }
  .actions { display: flex; align-items: center; gap: 14px; }
  .gh { display: inline-flex; align-items: center; gap: 7px; font-size: 15px; color: var(--mute); }
  .gh:hover { color: var(--ink); }
  .gh svg { width: 17px; height: 17px; fill: currentColor; }
  .menu { display: none; position: relative; }
  .menu summary { list-style: none; cursor: pointer; width: 40px; height: 40px; border-radius: var(--radius-s); border: 1px solid var(--line); display: grid; place-content: center; gap: 4px; }
  .menu summary::-webkit-details-marker { display: none; }
  .menu summary span { display: block; width: 16px; height: 1.5px; background: var(--ink); }
  .menu-panel {
    position: absolute; right: 0; top: calc(100% + 8px); min-width: 210px;
    display: grid; padding: 8px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
    box-shadow: 0 20px 40px -20px rgba(0, 0, 0, 0.6);
  }
  .menu-panel a { padding: 9px 12px; border-radius: var(--radius-s); color: var(--ink); }
  .menu-panel a:hover { background: var(--surface-2); }
  .nav a, .actions .btn { white-space: nowrap; }
  /* Seven menu items: tighten before the menu turns into the burger at 900px. */
  @media (max-width: 1180px) {
    .bar { gap: 16px; }
    .nav { gap: 0; font-size: 15px; }
    .nav a { padding: 8px 9px; }
    .nav a[aria-current="page"]::after { left: 9px; right: 9px; }
    .gh span { display: none; }
  }
  @media (max-width: 900px) {
    .nav, .gh { display: none; }
    .bar { justify-content: space-between; }
    .menu { display: block; }
  }
</style>
