---
// Starlight header override: the site logo and the same main menu as the marketing pages,
// then Starlight's search, social icons and theme select. Below 50rem the menu, social icons
// and theme select move into the sidebar popover (see DocsMobileMenuFooter.astro).
import Search from "@astrojs/starlight/components/Search.astro";
import SocialIcons from "@astrojs/starlight/components/SocialIcons.astro";
import ThemeSelect from "@astrojs/starlight/components/ThemeSelect.astro";
import Logo from "../Logo.astro";
import { flatNav } from "../../config/site";
import { currentNavHref } from "./nav";

const current = currentNavHref(Astro.url.pathname);
---

<div class="docs-header">
  <div class="brand">
    <Logo size={28} />
  </div>
  <nav class="site-nav sl-hidden md:sl-flex print:hidden" aria-label="Main">
    {flatNav.map((item) => (
      <a href={item.href} aria-current={item.href === current ? "page" : undefined}>{item.label}</a>
    ))}
  </nav>
  <div class="search print:hidden"><Search /></div>
  <div class="right-group sl-hidden md:sl-flex print:hidden">
    <div class="social-icons"><SocialIcons /></div>
    <ThemeSelect />
  </div>
</div>

<style>
  .docs-header {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    height: 100%;
    max-width: 100%;
  }
  .brand {
    display: flex;
    align-items: center;
    flex: none;
  }
  .brand :global(a) {
    text-decoration: none;
  }
  .site-nav {
    gap: 0.25rem;
    font-size: var(--sl-text-sm);
    white-space: nowrap;
  }
  .site-nav a {
    position: relative;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-s);
    color: var(--sl-color-gray-3);
    font-weight: 500;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .site-nav a:hover {
    color: var(--sl-color-white);
    background: color-mix(in srgb, var(--ink) 7%, transparent);
  }
  .site-nav a[aria-current="page"] {
    color: var(--sl-color-white);
    font-weight: 600;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }
  .site-nav a[aria-current="page"]::after {
    content: "";
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: calc(-1 * (var(--sl-nav-height) - 2.2rem) / 2);
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
  }
  .search {
    display: flex;
    justify-content: flex-end;
    margin-inline-start: auto;
    min-width: 0;
  }
  .right-group {
    align-items: center;
    gap: 1rem;
  }
  .social-icons {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .social-icons::after {
    content: "";
    height: 1.5rem;
    border-inline-end: 1px solid var(--sl-color-hairline-light);
  }
  @media (min-width: 50rem) {
    .search {
      flex: 0 1 16rem;
    }
  }
  @media (min-width: 50rem) and (max-width: 68rem) {
    .docs-header {
      gap: 1.25rem;
    }
    .site-nav {
      gap: 0;
    }
    .search {
      flex: none;
    }
    .search :global(button > span),
    .search :global(button > kbd) {
      display: none !important;
    }
  }
</style>
