{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo check:*)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo build:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo metadata:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git grep:*)",
      "Bash(git blame:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git fetch:*)",
      "Bash(git worktree list:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(scripts/check.sh:*)",
      "Bash(scripts/test_area.sh:*)",
      "Bash(scripts/run_with_servers.sh:*)",
      "Bash(scripts/check_hygiene.sh:*)",
      "Bash(bash scripts/check_hygiene.sh:*)",
      "Bash(python3 scripts/check_compatibility_matrix.py:*)",
      "Bash(python3 scripts/check_package_metadata.py:*)",
      "Bash(python3 scripts/test_release_version.py:*)",
      "Bash(python3 scripts/gen_client_keys.py --check:*)",
      "Bash(python3 scripts/client_stubs.py:*)",
      "Bash(python3 clients/java/tools/generate.py --check:*)",
      "Bash(dotnet run -c Release --project scripts/csharp-format:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin main:*)",
      "Bash(git push * main)",
      "Bash(git push --tags:*)",
      "Bash(git tag:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(cargo publish:*)",
      "Bash(npm publish:*)",
      "Bash(dotnet nuget push:*)",
      "Bash(twine upload:*)",
      "Bash(mvn deploy:*)",
      "Bash(gh release:*)",
      "Bash(gh workflow run:*)",
      "Bash(docker push:*)",
      "Bash(cargo test --release:*)",
      "Bash(cargo build --release:*)"
    ]
  }
}
