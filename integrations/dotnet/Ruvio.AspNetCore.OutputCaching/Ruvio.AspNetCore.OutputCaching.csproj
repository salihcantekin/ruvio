<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Version>0.2.0</Version>
    <Description>Binary ASP.NET Core output caching with distributed tag invalidation on Ruvio.</Description>
    <PackageId>Ruvio.AspNetCore.OutputCaching</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>ruvio;aspnetcore;outputcache</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Compile Include="../Common/RuvioStartupChecks.cs" Link="Common/RuvioStartupChecks.cs" />
    <ProjectReference Include="../../../clients/csharp/Ruvio.Client/Ruvio.Client.csproj" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../../brand/ruvio-icon-square.png" Pack="true" PackagePath="ruvio-icon.png" />
    <InternalsVisibleTo Include="Ruvio.AspNetCore.OutputCaching.Tests" />
  </ItemGroup>
</Project>
